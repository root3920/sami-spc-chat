# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only used by `npm run ingest` on your computer. Never add it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional. claude-sonnet-5-5 is the default; claude-haiku-5-5 is cheaper and faster.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- App ---
# Public URL of the app (used in password-reset and confirmation emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Messages per member per day (cost control)
DAILY_MESSAGE_LIMIT=60
# true = only emails in the allowed_members table can chat
REQUIRE_MEMBERSHIP=false
